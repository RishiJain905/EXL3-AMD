+def report_quant_memory(quant_args, phase):
+    """Optional allocation telemetry; no tensors or RNG state are retained."""
+    if not quant_args.get("memory_diagnostics", False):
+        return
+    import json
+    import time
+    print(json.dumps({"exl3_memory_phase": phase, "monotonic_seconds": time.monotonic(),
+                      "devices": [{"device": str(device),
+                                   "allocated_bytes": torch.cuda.memory_allocated(device),
+                                   "reserved_bytes": torch.cuda.memory_reserved(device)}
+                                  for device in quant_args["devices"]]}), flush = True)
+
+
+def ldlq_packed_columns(weight, L, H, quant_args, column_block_size = 4096):
+    """Encode independent output columns, retaining only packed output on CPU.
+
+    Global regularization and scale search must already be complete. Changing
+    GEMM width can change FP32 rounding; native packed parity is a separate check.
+    """
+    assert weight.device.type == "cpu" and weight.dtype == torch.float
+    assert quant_args.get("compact_cpu_buffers", False)
+    assert len(quant_args["devices"]) == 1, "Streamed LDLQ requires one device"
+    assert column_block_size > 0 and column_block_size % 128 == 0
+    k, n = weight.shape
+    assert k % 128 == 0 and n % 128 == 0
+    assert tuple(H.shape) == tuple(L.shape) == (k, k)
+    device = L.device
+    packed = torch.empty((k // 16, n // 16, 16 * quant_args["K"]), dtype = torch.short, device = "cpu")
+    Hd = H.to(device)
+    numerator = 0.0
+    denominator = 0.0
+    for start in range(0, n, column_block_size):
+        end = min(start + column_block_size, n)
+        report_quant_memory(quant_args, f"ldlq_columns_{start}_{end}_begin")
+        w = weight[:, start:end].contiguous()
+        q, encoded = ldlq(w, L, quant_args)
+        # Match compact proxy column order, accumulating numerator and denominator
+        # separately rather than averaging per-chunk ratios.
+        for offset in range(0, end - start, 1024):
+            w_gpu = w[:, offset:offset + 1024].to(device = device, dtype = torch.float)
+            q_gpu = q[:, offset:offset + 1024].to(device = device, dtype = torch.float)
+            error = w_gpu - q_gpu
+            numerator += block_trace(error, Hd)
+            denominator += block_trace(w_gpu, Hd)
+            del w_gpu, q_gpu, error
+        chunk = pack_trellis(encoded.to(device), quant_args)
+        packed[:, start // 16:end // 16, :].copy_(chunk.cpu())
+        del w, q, encoded, chunk
+        report_quant_memory(quant_args, f"ldlq_columns_{start}_{end}_end")
+    return numerator / max(denominator, 1e-8), packed
 
 
