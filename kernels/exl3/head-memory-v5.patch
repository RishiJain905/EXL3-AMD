+def block_proxy_error_streamed(W, Q, H, device, column_block_size = 1024):
+    """Same quadratic proxy, streaming output columns instead of full E/W copies.
+
+    The codec and FP32 LDLQ arithmetic are unchanged. Column blocking changes
+    floating-point reduction order, so metric agreement is tolerance-based.
+    """
+    assert W.shape == Q.shape and W.shape[0] == H.shape[0] == H.shape[1]
+    assert column_block_size > 0
+    Hd = H.to(device)
+    num = 0.0
+    den = 0.0
+    for start in range(0, W.shape[1], column_block_size):
+        end = min(start + column_block_size, W.shape[1])
+        w = W[:, start:end].to(device = device, dtype = torch.float)
+        q = Q[:, start:end].to(device = device, dtype = torch.float)
+        error = w - q
+        num += block_trace(error, Hd)
+        den += block_trace(w, Hd)
+        del w, q, error
+    return num / max(den, 1e-8)
+
